# ===== AI 供应商配置（OpenAI Compatible）=====
# 当前激活供应商，对应 application.yml 中 app.ai.providers 下的 key
AI_PROVIDER=deepseek

# DeepSeek（chat 能力强，无 embedding API）
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# OpenAI（chat + embedding 全支持）
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama（本地，embedding 兜底方案）
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ===== 基础设施 =====
MYSQL_PORT=3306
REDIS_PORT=6379
RABBIT_PORT=5672

# ===== JWT =====
JWT_SECRET=aiview-interview-platform-secret-key-please-change-in-production
